{
  "name": "spares-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-image-occlusion": "SPARES_OPEN='/svgedit/src/editor/index.html?storagePrompt=false' vite",
    "build": "bun run prepare-svgedit && tsc -b && vite build",
    "prepare-svgedit": "cd ./svgedit/ && bun install && ([ -d packages/svgcanvas/dist ] || npm run build --workspace @svgedit/svgcanvas)",
    "lint": "eslint .",
    "preview": "vite preview",
    "start-main": "bun install && bun run prepare-svgedit && bun run dev",
    "start-image-occlusion": "bun install && bun run prepare-svgedit && bun run dev-image-occlusion"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.4",
    "@myriaddreamin/typst-ts-renderer": "0.8.0-rc3",
    "@myriaddreamin/typst-ts-web-compiler": "0.8.0-rc3",
    "@myriaddreamin/typst.ts": "0.8.0-rc3",
    "@replit/codemirror-vim": "^6.4.0",
    "@uiw/react-codemirror": "^4.25.12",
    "codemirror-lang-typst": "^0.6.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-wasm": "^3.6.0"
  }
}
