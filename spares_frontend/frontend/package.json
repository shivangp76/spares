{
  "name": "spares-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-image-occlusion": "SPARES_OPEN='/svgedit/src/editor/index.html?storagePrompt=false' vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start-main": "bun install && bun run dev",
    "start-image-occlusion": "bun install && cd ./svgedit/ && bun install && [ -d packages/svgcanvas/dist ] || npm run build --workspace @svgedit/svgcanvas && cd ../ && bun run dev-image-occlusion"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-renderer": "^0.7.0-rc2",
    "@myriaddreamin/typst.ts": "^0.7.0-rc2",
    "@replit/codemirror-vim": "^6.3.0",
    "@uiw/react-codemirror": "^4.25.9",
    "dompurify": "^3.3.3",
    "marked": "^17.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
