# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# The browser build of spares_wasm (cargo xtask build-wasm)
spares_frontend/frontend/src/local/pkg/

# Lockfiles from building a vendored crate on its own; the workspace's Cargo.lock covers them
vendor/*/Cargo.lock
